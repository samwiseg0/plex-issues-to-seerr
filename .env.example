# Copy this file to .env and fill it in.
# Keep each comment on its own line. systemd EnvironmentFile does not read inline comments.

# Required. plex.tv token of the Plex server owner's account.
PLEX_TOKEN=your-token-here
# Required. Plex Media Server base URL.
PMS_URL=http://plex:32400
# Required. Seerr base URL the poller calls.
SEERR_URL=https://seerr.example.com
# Required. Seerr API key, from Settings, General.
SEERR_API_KEY=your-api-key-here

# Optional. Seerr URL for the link on the Plex report. Default: SEERR_URL.
#SEERR_PUBLIC_URL=https://seerr.example.com
# Optional. plex.tv username the reports are sent to. Default: the account that owns PLEX_TOKEN.
#PLEX_OWNER=your-plex-username
# Optional. Discord webhook for reports the poller cannot mirror. Unset: they go to the log.
#DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token
# Optional. The first run imports reports from this many days back. Default: 0.
#IMPORT_DAYS=30

# The Docker image sets the next three. The systemd unit sets STATE_FILE.
# Seconds between polls, 60 or more in a container. Empty uses the image default of 300.
# Outside a container, unset or 0 polls once and exits. The systemd unit ignores it.
#POLL_INTERVAL=300
# Path of the state file. Default: plex_issues_state.json in the working directory.
#STATE_FILE=/path/to/state.json
# File rewritten after every successful poll, for a healthcheck.
#HEARTBEAT_FILE=/path/to/heartbeat
